# ============================================================
# 오늘의 필름 백엔드 환경변수
# 이 파일을 .env 로 복사한 뒤 값을 채워서 사용
# ============================================================

# ─── 환경 ────────────────────────────────────────────
# dev | production
# production 이면: JWT_SECRET/CORS 기본값 차단, API 문서(/docs) 비공개
APP_ENV=dev

# ─── DB ─────────────────────────────────────────────
# 개발: SQLite (기본값). 운영: postgresql://user:pass@host:5432/todaysfilm
DATABASE_URL=sqlite:///./todaysfilm.db

# ─── 인증(JWT) ───────────────────────────────────────
# 운영 배포 전 반드시 랜덤한 긴 문자열로 교체할 것!
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=43200

# ─── CORS ────────────────────────────────────────────
# 운영에서는 쉼표로 도메인 지정: https://todaysfilm.app,https://www.todaysfilm.app
CORS_ORIGINS=*

# ─── AI 프로바이더 ★모델 교체 지점★ ─────────────────────
# gemini | mock  (키가 없으면 자동으로 mock 으로 동작)
# 추후 Claude 등 추가 시 app/ai/factory.py 참고
AI_PROVIDER=gemini
GEMINI_API_KEY=

# 용도별 모델 분리: 질문(고빈도·저비용) / 필름 생성(문체 품질) / 임베딩(기억 연결)
# 나중에 필름 생성만 상위 모델로 올리고 싶으면 FILM_MODEL만 바꾸면 됨
GEMINI_QUESTION_MODEL=gemini-2.5-flash
GEMINI_FILM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# LLM 호출 안정성
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ─── Rate Limit (시간당) ──────────────────────────────
RATE_LIMIT_LLM_PER_HOUR=60
RATE_LIMIT_AUTH_PER_HOUR=20

# ─── 서비스 정책 ──────────────────────────────────────
MAX_QUESTIONS=3
MAX_REGENERATIONS_PER_QUESTION=3
UPLOAD_DIR=./uploads
# 사진 업로드 용량 제한(MB). 고화질 원본 대응 기본 40
PHOTO_MAX_UPLOAD_MB=40

# ─── 3차 기능 ─────────────────────────────────────────
# 임베딩 기억 연결 최소 유사도 (0~1)
EMBEDDING_LINK_THRESHOLD=0.55
# 날씨 조회 (Open-Meteo, 무료·키 불필요)
WEATHER_ENABLED=true
